# Non-secret production configuration. Copy to a root-readable file on the VM.
CORS_ORIGINS=https://frontend-ashen-omega-66.vercel.app
EVAL_TRIALS=3
EVAL_CONCURRENCY=1
DRIFT_MAX_STEPS=12
DRIFT_TOKEN_BUDGET=20000
DRIFT_REPEAT_CALL_LIMIT=3
CASE_TIMEOUT_S=120
MEMORY_TOP_K=12
MEMORY_MIN_USES=4
ARCHITECT_ALLOW_GLUE_TOOLS=0

# API_AUTH_TOKEN must be generated locally and stored in the private runtime
# file. Model keys are deliberately absent until separately configured.
# API_AUTH_TOKEN=

LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_STRONG=gpt-4o
LLM_MODEL_CHEAP=gpt-4o-mini
