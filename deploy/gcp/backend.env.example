EVAL_TRIALS=1
EVAL_CONCURRENCY=1
DRIFT_MAX_STEPS=6
DRIFT_TOKEN_BUDGET=8000
DRIFT_REPEAT_CALL_LIMIT=3
CASE_TIMEOUT_S=120
MEMORY_TOP_K=12
MEMORY_MIN_USES=4
ARCHITECT_ALLOW_GLUE_TOOLS=0
PUBLIC_DEMO_LIMITS=1
DEMO_WORKFLOW_CONCURRENCY=1
DEMO_DAILY_ACTION_LIMIT=25
DEMO_CLIENT_HOURLY_LIMIT=5
DEMO_CLIENT_COOLDOWN_S=60
DEMO_DAILY_TOKEN_LIMIT=250000
DEMO_MAX_IMPROVE_ATTEMPTS=1
DEMO_REQUIRE_USAGE=1
