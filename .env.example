# LLM access (OpenAI-compatible endpoint) — backend/llm.py
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_STRONG=gpt-4o
LLM_MODEL_CHEAP=gpt-4o-mini

# Tracing is off unless BOTH values below are configured. A key alone never exports.
NEATLOGS_ENABLED=false
NEATLOGS_API_KEY=
# Prompt/response/tool content is omitted by default even when export is enabled.
NEATLOGS_CAPTURE_CONTENT=false
# Bounded defaults for small hosts (hard caps are enforced in the adapter).
NEATLOGS_BATCH_SIZE=32
NEATLOGS_FLUSH_INTERVAL_S=10
NEATLOGS_SHUTDOWN_TIMEOUT_MS=2000

# GitHub PAT for the github_triage toolbox (read-only scope is enough)
GITHUB_TOKEN=

# Optional locally; production deployment sets both. API_AUTH_TOKEN must be a
# high-entropy server-held value and must never be exposed through NEXT_PUBLIC_*.
API_AUTH_TOKEN=
REQUIRE_API_AUTH=0

# Comma-separated exact browser origins. CORS is not authentication.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Eval knobs
EVAL_TRIALS=3
# EVAL_REPEATS=3   # deprecated alias for EVAL_TRIALS; read only if EVAL_TRIALS is unset
EVAL_CONCURRENCY=4

# Drift watchdog
DRIFT_MAX_STEPS=12
DRIFT_TOKEN_BUDGET=20000
DRIFT_REPEAT_CALL_LIMIT=3

# Per-case wall-clock timeout in seconds (checked cooperatively between LLM
# calls and after every tool return; recorded as a drift_detected(kind=budget))
CASE_TIMEOUT_S=120

# Memory injection (backend/runtime/memory.py)
MEMORY_TOP_K=12
MEMORY_MIN_USES=4

# SQLite ledger path (optional; defaults to runs/to.sqlite3)
# TO_DB_PATH=runs/to.sqlite3

# Frontend
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_USE_MOCKS=true
