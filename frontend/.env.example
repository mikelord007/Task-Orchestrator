# 1 = every api.ts call is served from frontend/lib/mocks instead of the backend.
NEXT_PUBLIC_USE_MOCKS=1
# Browser requests stay same-origin; the route handler adds backend credentials.
NEXT_PUBLIC_API_BASE=/api/backend
# Keep model-dependent controls disabled unless the backend has provider credentials.
NEXT_PUBLIC_LIVE_MODEL_CALLS=0
# Optional live evidence source for the landing page. It must name a real stored agent.
NEXT_PUBLIC_DEMO_AGENT_ID=

# Server-only proxy configuration. Never prefix these with NEXT_PUBLIC_.
BACKEND_API_URL=https://backend.example.com
BACKEND_BEARER_TOKEN=
ENABLE_LIVE_MODEL_CALLS=0
